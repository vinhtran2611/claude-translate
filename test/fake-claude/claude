#!/usr/bin/env node
// A stand-in for the claude CLI in tests: put this folder first on PATH. It reads one stream-json user message from
// stdin and prints canned stream-json, like `claude -p --output-format stream-json --include-partial-messages`.
// The scenario is a marker in the message text:
//   FAKE:ok            (default) one <pair> reply, then a success result
//   FAKE:error         an error result (is_error: true)
//   FAKE:crash         prints to stderr and exits 1 without a result
//   FAKE:silent_first  stays silent unless --model is claude-haiku-5-5, so the server falls back to Haiku
//   FAKE:stall         sends one token, then nothing
//   FAKE:reply=<text>  replies with <text> as is (the rest of that line), then a success result
// FAKE_CLAUDE_LOG: a file to append one JSON line per run with the arguments and the message text.
import { appendFileSync } from 'node:fs';

const args = process.argv.slice(2);
const model_id = args[args.indexOf('--model') + 1];

function print(message) {
  process.stdout.write(`${JSON.stringify(message)}\n`);
}

function textDelta(text) {
  return { type: 'stream_event', event: { type: 'content_block_delta', index: 0, delta: { type: 'text_delta', text } } };
}

function reply(text) {
  print({ type: 'stream_event', event: { type: 'message_start' } });
  print({ type: 'stream_event', event: { type: 'content_block_start', index: 0, content_block: { type: 'text' } } });
  print(textDelta(text));
  print({ type: 'stream_event', event: { type: 'content_block_stop', index: 0 } });
  print({ type: 'stream_event', event: { type: 'message_delta', delta: { stop_reason: 'end_turn' } } });
  print({ type: 'result', subtype: 'success', is_error: false, result: text, usage: { output_tokens: 42 } });
}

let input = '';
process.stdin.on('data', (chunk) => { input += chunk; });
process.stdin.on('end', () => {
  const content = JSON.parse(input.split('\n')[0]).message.content;
  if (process.env.FAKE_CLAUDE_LOG) appendFileSync(process.env.FAKE_CLAUDE_LOG, `${JSON.stringify({ args, content })}\n`);
  print({ type: 'system', subtype: 'init' });
  const reply_match = /FAKE:reply=(.*)/.exec(content);
  if (reply_match) {
    reply(reply_match[1]);
  } else if (content.includes('FAKE:error')) {
    print({ type: 'result', subtype: 'error_during_execution', is_error: true, result: 'Fake API error', api_error_status: 500 });
  } else if (content.includes('FAKE:crash')) {
    process.stderr.write('fake claude crashed\n');
    process.exit(1);
  } else if (content.includes('FAKE:silent_first') && model_id !== 'claude-haiku-5-5') {
    setInterval(() => {}, 1000);
  } else if (content.includes('FAKE:stall')) {
    print(textDelta('<pair type="paragraph">'));
    setInterval(() => {}, 1000);
  } else {
    reply('<pair type="paragraph">\n<source>\nHello\n</source>\n<translation>\nXin chào\n</translation>\n</pair>');
  }
});
